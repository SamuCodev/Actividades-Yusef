---
// Imagen inicial o de respaldo
const defaultImage = "/img/Lucky.jpeg";
---

<div id="cursor-trail" aria-hidden="true">
  <img id="cursor-trail-img" src={defaultImage} alt="" />
</div>

<script>
  // Solo en dispositivos con mouse
  if (window.matchMedia("(pointer: fine)").matches) {
    const trail = document.getElementById("cursor-trail");
    const img = document.getElementById("cursor-trail-img") as HTMLImageElement | null;

    if (trail && img) {
      const SIZE = 200; // debe coincidir con el CSS
      const LERP = 0.12; // suavizado del movimiento
      const TARGET = "[data-trail]"; // elementos que activan el efecto

      // Precargar todas las imágenes de las cards para que no haya parpadeo
      document.querySelectorAll(`${TARGET}[data-image], ${TARGET}[data-trail]`).forEach((el) => {
        const src = el.getAttribute("data-image") || el.getAttribute("data-trail");
        if (src && src !== "true") {
          const preload = new Image();
          preload.src = src;
        }
      });

      let mouseX = 0,
        mouseY = 0;
      let x = 0,
        y = 0;
      let currentTarget: Element | null = null;
      let firstMove = true;

      window.addEventListener("mousemove", (e: MouseEvent) => {
        mouseX = e.clientX;
        mouseY = e.clientY;

        if (firstMove) {
          x = mouseX;
          y = mouseY;
          firstMove = false;
        }

        // Detectar si el cursor está sobre un elemento objetivo
        const target = e.target instanceof Element ? e.target.closest(TARGET) : null;

        if (target) {
          // Si entramos a una card distinta, cambiamos a su imagen específica
          if (target !== currentTarget) {
            currentTarget = target;
            const specificImage = target.getAttribute("data-image") || target.getAttribute("data-trail");
            if (specificImage && specificImage !== "true" && specificImage !== "") {
              img.src = specificImage;
            }
          }
          trail.classList.add("visible");
        } else {
          currentTarget = null;
          trail.classList.remove("visible");
        }
      });

      // Si el mouse sale de la ventana, ocultar
      document.addEventListener("mouseleave", () => {
        currentTarget = null;
        trail.classList.remove("visible");
      });

      function animate() {
        // Lerp: acerca el círculo al mouse poco a poco
        x += (mouseX - x) * LERP;
        y += (mouseY - y) * LERP;

        // Centrar el círculo en el cursor
        trail.style.transform = `translate(${x - SIZE / 2}px, ${y - SIZE / 2}px)`;

        requestAnimationFrame(animate);
      }

      animate();
    }
  }
</script>

<style>
  #cursor-trail {
    position: fixed;
    top: 0;
    left: 0;
    width: 250px;
    height: 250px;
    border-radius: 50%;
    overflow: hidden;
    pointer-events: none;
    z-index: 9999;
    opacity: 0;
    scale: 0.6;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4), 0 0 0 2px rgba(255, 255, 255, 0.15);
    transition:
      opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1),
      scale 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  #cursor-trail.visible {
    opacity: 1;
    scale: 1;
  }

  #cursor-trail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>